# /etc/flow-ultra-agent.env (root 0600). No real values in git.
FLOW_BASE=https://flow.example.com
# Same value as ULTRA_AGENT_TOKEN in flow2api's environment (Coolify). NOT the plugin connection token.
ULTRA_AGENT_TOKEN=
HOST_ID=cf-worker-01
# Image built from this tree's docker/flow-ultra (its entrypoint has FU_REQUIRE_PROXY). A new tag, so the
# hand-made flow-ultra-01/02 keep running on flow-browser:4 untouched.
FU_IMAGE=flow-browser:5
FU_ROOT=/srv/flow-ultra-browsers
FU_ETC=/etc/flow-ultra-browsers
FU_MEMORY=3g
POLL_S=5
